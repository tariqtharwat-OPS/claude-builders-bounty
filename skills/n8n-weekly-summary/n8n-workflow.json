{
  "name": "Weekly Dev Summary - GitHub + Claude",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "name": "Weekly Trigger (Friday 5PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "GITHUB_OWNER",
              "value": "={{ $env.GITHUB_OWNER || 'your-org' }}"
            },
            {
              "name": "GITHUB_REPO",
              "value": "={{ $env.GITHUB_REPO || 'your-repo' }}"
            },
            {
              "name": "WEBHOOK_URL",
              "value": "={{ $env.WEBHOOK_URL || '' }}"
            },
            {
              "name": "ANTHROPIC_API_KEY",
              "value": "={{ $env.ANTHROPIC_API_KEY || '' }}"
            },
            {
              "name": "LANGUAGE",
              "value": "={{ $env.LANGUAGE || 'EN' }}"
            },
            {
              "name": "recipient_email",
              "value": "={{ $env.RECIPIENT_EMAIL || '' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{ $json.GITHUB_OWNER }}",
        "repository": "={{ $json.GITHUB_REPO }}",
        "state": "closed",
        "since": "={{ $now.minus({ weeks: 1 }).toISO() }}",
        "returnAll": true
      },
      "name": "Get Closed Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [680, 200],
      "credentials": {
        "githubApi": {
          "id": "github-creds",
          "name": "GitHub Account"
        }
      }
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "getAll",
        "owner": "={{ $json.GITHUB_OWNER }}",
        "repository": "={{ $json.GITHUB_REPO }}",
        "state": "closed",
        "returnAll": true
      },
      "name": "Get Merged PRs",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [680, 400],
      "credentials": {
        "githubApi": {
          "id": "github-creds",
          "name": "GitHub Account"
        }
      }
    },
    {
      "parameters": {
        "resource": "repository",
        "operation": "getCommits",
        "owner": "={{ $json.GITHUB_OWNER }}",
        "repository": "={{ $json.GITHUB_REPO }}",
        "since": "={{ $now.minus({ weeks: 1 }).toISO() }}",
        "returnAll": true
      },
      "name": "Get Weekly Commits",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [680, 600],
      "credentials": {
        "githubApi": {
          "id": "github-creds",
          "name": "GitHub Account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "name": "Merge Activity Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "options": {
          "responseFormat": "text"
        },
        "model": "claude-sonnet-4-20250514",
        "promptType": "define",
        "text": "=Generate a weekly development summary in {{ $json.LANGUAGE == 'FR' ? 'French' : 'English' }} from the following GitHub activity data for the repository {{ $json.GITHUB_OWNER }}/{{ $json.GITHUB_REPO }}.\n\nClosed Issues (last 7 days):\n{{ JSON.stringify($json.issues || [], null, 2) }}\n\nMerged Pull Requests (last 7 days):\n{{ JSON.stringify($json.prs || [], null, 2) }}\n\nCommits (last 7 days):\n{{ JSON.stringify($json.commits || [], null, 2) }}\n\nFormat as Markdown with these sections:\n## Weekly Development Summary - {{ $now.toFormat('yyyy-MM-dd') }}\n\n### 📊 Overview\n- Total commits this week\n- Issues closed this week\n- PRs merged this week\n\n### 🔥 Key Changes\n- Summarize the most significant code changes and features\n\n### 🐛 Bug Fixes\n- List notable bug fixes from closed issues and commit messages\n\n### ✨ New Features\n- List new features from merged PRs and commit messages\n\n### 📈 Metrics\n- Commit frequency (commits per day)\n- Issue resolution rate\n- Average PR size\n\nKeep the summary concise but informative. Focus on what matters to the development team."
      },
      "name": "Claude Weekly Summary",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [1120, 400],
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-creds",
          "name": "Anthropic Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.WEBHOOK_URL }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Has Webhook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.text }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM || 'noreply@example.com' }}",
        "toEmail": "={{ $json.recipient_email }}",
        "subject": "=Weekly Dev Summary - {{ $json.GITHUB_REPO }} - {{ $now.toFormat('yyyy-MM-dd') }}",
        "html": "={{ $json.text }}",
        "options": {}
      },
      "name": "Send via Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1560, 500],
      "credentials": {
        "smtp": {
          "id": "smtp-creds",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Weekly Trigger (Friday 5PM)": {
      "main": [
        [
          {
            "node": "Set Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Configuration": {
      "main": [
        [
          {
            "node": "Get Closed Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Merged PRs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Weekly Commits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Closed Issues": {
      "main": [
        [
          {
            "node": "Merge Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Merged PRs": {
      "main": [
        [
          {
            "node": "Merge Activity Data",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Get Weekly Commits": {
      "main": [
        [
          {
            "node": "Merge Activity Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Activity Data": {
      "main": [
        [
          {
            "node": "Claude Weekly Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Weekly Summary": {
      "main": [
        [
          {
            "node": "Has Webhook?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Webhook?": {
      "main": [
        [
          {
            "node": "Send to Discord/Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send via Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}
